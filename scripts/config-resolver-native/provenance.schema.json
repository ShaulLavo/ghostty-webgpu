{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "runAttempt",
    "nativeBuildSourceHead",
    "nativeInputsTreeSha256",
    "sourceTree",
    "sourceDateEpoch",
    "target",
    "upstreamRevision",
    "upstreamTreeSha256",
    "runner",
    "toolchain",
    "archive",
    "files",
    "compatibility",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
    "nativeBuildSourceHead": { "$ref": "contract.schema.json#/$defs/revision" },
    "nativeInputsTreeSha256": { "$ref": "contract.schema.json#/$defs/hash" },
    "sourceTree": { "const": "clean" },
    "sourceDateEpoch": { "const": 1787590337 },
    "target": { "$ref": "contract.schema.json#/$defs/target" },
    "upstreamRevision": { "const": "c8554f28e0efe2f5595f32020371c34b25ec628f" },
    "upstreamTreeSha256": {
      "const": "63d2b0c41531162a70b838369c0c225745e167495763ebbd0bc2fe546976a2bb"
    },
    "runner": { "$ref": "contract.schema.json#/$defs/runner" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "archive": { "$ref": "#/$defs/archive" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "contract.schema.json#/$defs/artifactFile" }
    },
    "compatibility": { "$ref": "contract.schema.json#/$defs/compatibility" },
    "checks": { "$ref": "#/$defs/checks" }
  },
  "$defs": {
    "nativeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "$ref": "contract.schema.json#/$defs/printable" },
        "version": { "$ref": "contract.schema.json#/$defs/printable" },
        "sha256": { "$ref": "contract.schema.json#/$defs/hash" }
      }
    },
    "macosSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "xcodeVersion", "xcodeBuild", "sdkVersion", "sdkSettingsSha256"],
      "properties": {
        "kind": { "const": "macos" },
        "xcodeVersion": { "$ref": "contract.schema.json#/$defs/printable" },
        "xcodeBuild": { "type": "string", "pattern": "^[0-9]{1,4}[A-Z][0-9]{1,4}[a-z]?$" },
        "sdkVersion": { "$ref": "contract.schema.json#/$defs/dottedVersion" },
        "sdkSettingsSha256": { "$ref": "contract.schema.json#/$defs/hash" }
      }
    },
    "linuxSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sysrootName", "sysrootVersion", "sysrootSha256"],
      "properties": {
        "kind": { "const": "linux" },
        "sysrootName": { "$ref": "contract.schema.json#/$defs/printable" },
        "sysrootVersion": { "$ref": "contract.schema.json#/$defs/printable" },
        "sysrootSha256": { "$ref": "contract.schema.json#/$defs/hash" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zig", "linker", "strip", "sdk", "buildRecipeSha256"],
      "properties": {
        "zig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "const": "0.16.0" },
            "sha256": { "$ref": "contract.schema.json#/$defs/hash" }
          }
        },
        "linker": { "$ref": "#/$defs/nativeTool" },
        "strip": { "$ref": "#/$defs/nativeTool" },
        "sdk": { "oneOf": [{ "$ref": "#/$defs/macosSdk" }, { "$ref": "#/$defs/linuxSdk" }] },
        "buildRecipeSha256": { "$ref": "contract.schema.json#/$defs/hash" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "bytes"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^ghostty-config-resolver-(?:darwin-arm64|darwin-x64|linux-arm64|linux-x64)\\.tar$"
        },
        "sha256": { "$ref": "contract.schema.json#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "noWrite", "privacy", "relocation", "dependencies"],
      "properties": {
        "semantic": { "const": "pass" },
        "noWrite": { "const": "pass" },
        "privacy": { "const": "pass" },
        "relocation": { "const": "pass" },
        "dependencies": { "const": "pass" }
      }
    }
  }
}
