{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proofRecipeSha256",
    "sourceDateEpoch",
    "upstream",
    "zigVersion",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "proofRecipeSha256": {
      "const": "40083f27ad5f925808cc48e0fdd428b4ab0515eb38dedb42b0ca2065a16e44f0"
    },
    "sourceDateEpoch": { "const": 1787590337 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "treeSha256"],
      "properties": {
        "repository": { "const": "https://github.com/ghostty-org/ghostty.git" },
        "revision": { "const": "c8554f28e0efe2f5595f32020371c34b25ec628f" },
        "treeSha256": {
          "const": "63d2b0c41531162a70b838369c0c225745e167495763ebbd0bc2fe546976a2bb"
        }
      }
    },
    "zigVersion": { "const": "0.16.0" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"],
      "properties": {
        "darwin-arm64": { "$ref": "#/$defs/targetRecipe" },
        "darwin-x64": { "$ref": "#/$defs/targetRecipe" },
        "linux-arm64": { "$ref": "#/$defs/targetRecipe" },
        "linux-x64": { "$ref": "#/$defs/targetRecipe" }
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "targetRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "targetTriple",
        "optimizationMode",
        "buildArgv",
        "linkPlan",
        "stripArgv",
        "environment",
        "tools",
        "inputs"
      ],
      "properties": {
        "runner": { "$ref": "contract.schema.json#/$defs/runner" },
        "targetTriple": { "type": "string", "minLength": 1, "maxLength": 256 },
        "optimizationMode": { "const": "ReleaseSafe" },
        "buildArgv": { "$ref": "#/$defs/argv" },
        "linkPlan": { "$ref": "#/$defs/argv" },
        "stripArgv": { "$ref": "#/$defs/argv" },
        "environment": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
              "value": { "type": "string", "maxLength": 4096 }
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "contract.schema.json#/$defs/toolRecord" }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "contract.schema.json#/$defs/inputRecord" }
        }
      }
    }
  }
}
