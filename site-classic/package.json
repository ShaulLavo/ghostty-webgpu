{
  "name": "ghostty-webgpu-classic-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run --cwd .. build && bun run --cwd ../packages/line-editor build",
    "build": "bun run typecheck && bun run docs:check && bun scripts/sync-assets.ts && astro build",
    "dev": "bun scripts/sync-assets.ts && astro dev",
    "preview": "astro preview",
    "typecheck": "../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "docs:check": "bun ../site/scripts/check-docs.ts && bun test ../site/scripts/pty.test.ts ../site/worker/index.test.ts && bun run test",
    "verify:first-frame": "node scripts/verify-first-frame.mjs",
    "test": "bun run --cwd .. test:site-classic"
  },
  "dependencies": {
    "ghostty-webgpu-line-editor": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.5",
    "@shikijs/themes": "4.4.3",
    "@types/bun": "1.4.2",
    "@webgpu/types": "0.1.74",
    "astro": "7.3.5",
    "just-bash": "3.6.0",
    "playwright": "1.63.0",
    "starlight-links-validator": "0.26.0",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "npm:typescript@6.0.3"
  }
}
