{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "ghostty-webgpu": ["../../dist/index.d.ts"]
    },
    "types": ["@webgpu/types"],
    "resolveJsonModule": true
  },
  "include": ["src", "vitest.config.ts"]
}
