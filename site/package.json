{
  "name": "ghostty-webgpu-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run docs:check && bun scripts/sync-assets.ts && astro build",
    "dev": "bun scripts/sync-assets.ts && astro dev",
    "preview": "astro preview",
    "typecheck": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json && ../../node_modules/.bin/tsc --noEmit -p tsconfig.tests.json",
    "verify:sections": "bun scripts/verify-sections.ts",
    "verify:migration": "bun scripts/verify-migration.ts",
    "docs:check": "bun scripts/check-docs.ts && bun test scripts/pty.test.ts"
  },
  "dependencies": {
    "ghostty-webgpu": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.5",
    "@shikijs/themes": "4.4.3",
    "@types/bun": "1.4.2",
    "@webgpu/types": "0.1.74",
    "astro": "7.3.5",
    "just-bash": "3.6.0",
    "playwright": "1.63.0",
    "starlight-links-validator": "0.26.0",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "npm:typescript@6.0.3"
  }
}
