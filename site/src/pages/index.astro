---
import pageCss from '../styles/styles.css?inline'
import fontCss from '../styles/fonts.css?inline'
import firstFrameCss from '../styles/first-frame.css?inline'
import sectionsCss from '../styles/sections.css?inline'
import { firstGhostFrame } from '../first-frame.js'
import Benchmark from '../components/Benchmark.astro'
import Correctness from '../components/Correctness.astro'
import Migration from '../components/Migration.astro'
import { docsHref, docsIndex, roadmap } from '../site-links'

const firstFrame = await firstGhostFrame()

const version = __SITE_VERSION__
const base = import.meta.env.BASE_URL
const fontStyles = fontCss.replaceAll('/ghostty-webgpu/', `${base.replace(/\/$/, '')}/`)
const roadmapLabels = { done: 'Done', progress: 'In progress' } as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ghostty-webgpu: Ghostty's terminal, in the browser</title>
    <style is:inline set:html={pageCss + fontStyles + firstFrameCss + sectionsCss}></style>
    <meta
      name="description"
      content="The real libghostty-vt core, unpatched, compiled to WebAssembly, with four renderers that draw only what changed. Try it live."
    />
    <script is:inline>
      document.documentElement.style.setProperty('--ghost-device-pixel', `${1 / devicePixelRatio}px`)
    </script>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/jetbrains-mono-latin-600-normal.woff2" fetchpriority="low" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/jetbrains-mono-latin-400-italic.woff2" fetchpriority="low" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/bricolage-grotesque-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="ghostty-vt.wasm" fetchpriority="low" as="fetch" type="application/wasm" crossorigin />
    <link rel="preload" href="ghost-frames.txt.gz" fetchpriority="low" as="fetch" crossorigin />
  </head>
  <body>
    <header class="masthead">
      <div class="identity">
        <a class="wordmark" href={base}>ghostty-webgpu</a>
        <a class="version" href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md" title="Changelog">v{version}</a>
      </div>
      <nav class="links" aria-label="Project links">
        <a href={docsHref()}>Docs</a>
        <a href="#measured">Benchmarks</a>
        <a href="https://github.com/ShaulLavo/ghostty-webgpu">GitHub</a>
        <a href="https://www.npmjs.com/package/ghostty-webgpu">npm</a>
      </nav>
    </header>

    <main class="page">
      <section class="intro">
        <h1>Ghostty's terminal, in the browser.</h1>
        <p class="lede">
          The real libghostty-vt core, unpatched, compiled to WebAssembly. Four renderers that draw only what changed, built to run dozens of terminals on one page.
        </p>
        <div class="install">
          <code>npm install ghostty-webgpu</code>
          <button id="copy-install" type="button">Copy</button>
        </div>
        <p class="used-in">
          <img src="fregat.svg" alt="" width="22" height="22" />
          <span>Runs every terminal in <a href="https://github.com/ShaulLavo/fregat">Fregat</a>, an IDE in your browser.</span>
        </p>
      </section>

      <section class="window" id="window" data-ready="true" aria-label="Live terminal">
        <div class="chrome">
          <div class="window-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="tabs" id="tabs" role="tablist" aria-label="Demos">
            <button type="button" role="tab" data-demo="ghost" aria-selected="true">Ghost</button>
            <button type="button" role="tab" data-demo="matrix" aria-selected="false">Matrix</button>
            <button type="button" role="tab" data-demo="shell" aria-selected="false">Shell</button>
          </div>
          <span class="backend" id="backend" title="Renderer in use on this device">html</span>
        </div>
        <div class="screen">
          <div id="terminal" role="tabpanel" aria-label="Animated Ghostty ghost">
            <div id="ghost-first-frame" set:html={firstFrame}></div>
          </div>
        </div>
      </section>
      <p class="caption" id="caption"></p>
      <p class="stat" id="stat" aria-live="polite"></p>
      <Benchmark />
      <section class="usage" aria-label="Usage">
        <pre class="example" aria-label="Create a terminal"><code><span class="tk-k">import</span> <span class="tk-p">{'{'}</span> <span class="tk-t">Terminal</span> <span class="tk-p">{'}'}</span> <span class="tk-k">from</span> <span class="tk-s">'ghostty-webgpu'</span>

<span class="tk-k">const</span> host <span class="tk-p">=</span> document.<span class="tk-f">getElementById</span><span class="tk-p">(</span><span class="tk-s">'terminal'</span><span class="tk-p">)!</span>
<span class="tk-k">const</span> terminal <span class="tk-p">=</span> <span class="tk-k">await</span> <span class="tk-t">Terminal</span>.<span class="tk-f">create</span><span class="tk-p">()</span>
<span class="tk-k">await</span> terminal.<span class="tk-f">open</span><span class="tk-p">(</span>host<span class="tk-p">)</span>
terminal.<span class="tk-f">write</span><span class="tk-p">(</span><span class="tk-s">'hello from ghostty\r\n'</span><span class="tk-p">)</span>
terminal.<span class="tk-f">focus</span><span class="tk-p">()</span></code></pre>
        <details class="pty-example">
          <summary>Connect a WebSocket PTY</summary>
          <pre class="example" aria-label="WebSocket PTY wiring"><code><span class="tk-k">const</span> socket <span class="tk-p">=</span> <span class="tk-k">new</span> <span class="tk-t">WebSocket</span><span class="tk-p">(</span><span class="tk-s">'wss://host/pty'</span><span class="tk-p">)</span>
socket.binaryType <span class="tk-p">=</span> <span class="tk-s">'arraybuffer'</span>

terminal.<span class="tk-f">onData</span><span class="tk-p">((</span>bytes<span class="tk-p">) =&gt;</span> <span class="tk-p">{'{'}</span>
  <span class="tk-k">if</span> <span class="tk-p">(</span>socket.readyState <span class="tk-p">!==</span> <span class="tk-t">WebSocket</span>.OPEN<span class="tk-p">)</span> <span class="tk-k">return</span>
  socket.<span class="tk-f">send</span><span class="tk-p">(</span><span class="tk-k">new</span> <span class="tk-t">Uint8Array</span><span class="tk-p">(</span>bytes<span class="tk-p">))</span>
<span class="tk-p">{'}'})</span>

socket.<span class="tk-f">addEventListener</span><span class="tk-p">(</span><span class="tk-s">'message'</span><span class="tk-p">,</span> <span class="tk-p">(</span><span class="tk-p">{'{'}</span> data <span class="tk-p">{'}'}</span><span class="tk-p">) =&gt;</span> <span class="tk-p">{'{'}</span>
  <span class="tk-k">if</span> <span class="tk-p">(!(</span>data <span class="tk-k">instanceof</span> <span class="tk-t">ArrayBuffer</span><span class="tk-p">))</span> <span class="tk-k">return</span>
  terminal.<span class="tk-f">write</span><span class="tk-p">(</span><span class="tk-k">new</span> <span class="tk-t">Uint8Array</span><span class="tk-p">(</span>data<span class="tk-p">))</span>
<span class="tk-p">{'}'})</span></code></pre>
          <p>The mount needs a height and width. Dispose the terminal and close the socket when the connection ends.</p>
        </details>
      </section>

      <section class="facts" aria-label="What makes it different">
        <p>
          <strong>Only what changed is drawn.</strong> The renderer tracks damage per cell, so an
          idle terminal costs nothing and a busy one costs only its busy rows.
        </p>
        <p>
          <strong>Runs anywhere.</strong> WebGPU where the browser has it, then WebGL2, then Canvas2D, then plain DOM. Each draws the same cells. This page is drawing with <span id="backend-fact">html</span>.
        </p>
        <p>
          <strong>Off the main thread.</strong> Import <code>ghostty-webgpu/worker</code> and the emulator,
          frame builder and renderer run in a worker on an OffscreenCanvas.
        </p>
      </section>
      <Correctness />
      <Migration />
      <section class="sect" aria-labelledby="docs-heading">
        <h2 id="docs-heading">Docs</h2>
        <div class="docs-grid">{docsIndex.map((column) => (
          <div class="docs-col">
            <h3><a href={column.links[0]!.href}>{column.title}</a></h3>
            <ul>{column.links.map((link) => (
              <li><a href={link.href}>{link.code ? <code>{link.label}</code> : link.label}</a></li>
            ))}</ul>
          </div>
        ))}</div>
      </section>
    </main>

    <footer class="colophon">
      <section class="preview" aria-labelledby="preview-heading">
        <h2 id="preview-heading">Roadmap</h2>
        <table class="roadmap">
          <tbody>{roadmap.map((item) => (
            <tr><td class={`st-${item.state}`}>{roadmapLabels[item.state]}</td><td><a class="roadmap-link" href={item.plan}>{item.text}</a></td></tr>
          ))}</tbody>
        </table>
      </section>
      <nav class="footer-links" aria-label="Related">
        <a href="https://github.com/ShaulLavo/fregat">Fregat</a>
        <a href="https://github.com/ShaulLavo/singapore">Singapore editor</a>
        <a href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md">Changelog</a>
      </nav>
      <p>
        MIT licensed. Built on libghostty-vt. Not affiliated with the Ghostty project. The ghost
        animation is from <a href="https://github.com/ghostty-org/website">ghostty.org</a>, used
        under its MIT license.
      </p>
    </footer>

    <script src="../main.ts"></script>
  </body>
</html>
