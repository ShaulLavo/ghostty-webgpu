---
import landingCss from '../styles/landing.css?inline'
import SceneTheme from '../components/SceneTheme.astro'
import gridSource from '../scene/grid.js?raw'
import firstFrameSource from '../scene/first-frame.js?raw'
import { box, chart, columns, fact, score, serverHtml, still, wordmark, working } from '../scene/art'
import { benchLinks, benchTabs } from '../measurements'
import { core, correctness } from '../correctness'
import { docsHref, docsIndex, roadmap } from '../site-links'
import { migrationComparison } from '../examples/migration-comparison'

const version = __SITE_VERSION__
const base = import.meta.env.BASE_URL

const facts = [
  ['Only what changed is drawn', 'The renderer tracks damage per cell, so an idle terminal costs nothing and a busy one costs only its busy rows.'],
  ['Runs anywhere', 'WebGPU where the browser has it, then WebGL2, then Canvas2D, then plain DOM. Each draws the same cells.'],
  ['Off the main thread', 'Import ghostty-webgpu/worker and the emulator, frame builder and renderer run in a worker on an OffscreenCanvas.'],
] as const

const measured = benchTabs.map((tab) => {
  if (tab.kind === 'pending') return { tab, data: undefined, max: 0 }
  const data = Object.fromEntries(tab.rows.map((row) => [row.workload, row.energy]))
  return { tab, data, max: Math.max(1.4, ...tab.rows.map((row) => row.energy)) }
})

const total = correctness.upstreamCases + correctness.localCases
const scores = correctness.scores.map((entry) => ({
  label: `${entry.terminal} ${entry.version}`.trim(),
  value: entry.pass / total,
  ours: entry.terminal === 'ghostty-webgpu',
  text: `${entry.pass} of ${total}`,
}))

// The banner as its canvas colours it: letters (its ▓ fill) fade from the accent to the second colour across the
// columns, and the shadow strokes are ascii.rest's grey.
function wordmarkLayers(text: string) {
  return {
    letters: text.replace(/[^▓\n]/g, ' '),
    shadow: text.replace(/▓/g, ' '),
  }
}

// Each ascii.rest piece on the page: the server writes its first frame as text, and the page redraws it in the
// scene's colours.
const arts = {
  wordmark: wordmarkLayers(still(wordmark)),
}
const pageData = {
  charts: measured.map(({ data, max }) => (data ? { data, max } : null)),
  scores: scores.map(({ label, value, ours }) => ({ label, value, ours })),
}

// The grid module and the first-frame painter, inlined and scoped so the hero paints before any bundle loads.
const firstFrameScript = ['(() => {', gridSource.replace(/^export /gm, ''), firstFrameSource, '})()'].join('\n')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ghostty-webgpu: Ghostty's terminal, in the browser</title>
    <meta name="description" content="The real libghostty-vt core, unpatched, compiled to WebAssembly, with four renderers that draw only what changed." />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="ghostty-vt.wasm" as="fetch" type="application/wasm" crossorigin />
    <link rel="preload" href="bridge.wasm" as="fetch" type="application/wasm" crossorigin />
    <SceneTheme fresh />
    <style is:inline set:html={landingCss}></style>
  </head>
  <body>
    <header class="hero">
      <div class="scene" id="scene" aria-hidden="true" inert>
        <canvas class="scene-first" id="scene-first"></canvas>
      </div>
      <script type="text/plain" id="scene-frame"></script>
      <script is:inline set:html={firstFrameScript}></script>
      <div class="hero-copy">
        <h1>
          <span class="sr-only">ghostty-webgpu</span>
          <span class="art wordmark" data-art="wordmark" aria-hidden="true" style={box(wordmark)}><pre><span class="letters">{arts.wordmark.letters}</span><span class="shadow">{arts.wordmark.shadow}</span></pre></span>
        </h1>
        <p class="lede">Ghostty's terminal, in the browser. The real libghostty-vt core, unpatched, compiled to WebAssembly.</p>
      </div>
    </header>

    <nav class="bar" aria-label="Project">
      <a href={docsHref()}>[ docs ]</a>
      <a href="#measured">[ benchmarks ]</a>
      <a href="https://github.com/ShaulLavo/ghostty-webgpu">[ github ]</a>
      <a href="https://www.npmjs.com/package/ghostty-webgpu">[ npm ]</a>
      <a class="version" href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md">v{version}</a>
      <span class="credit" id="credit">scene from <a href="https://ascii.rest">ascii.rest</a></span>
    </nav>

    <main>
      <section class="install" aria-label="Install">
        <span class="prompt">&gt;</span>
        <code id="install-command">npm install ghostty-webgpu</code>
        <button type="button" id="copy-install">[ copy ]</button>
      </section>

      <hr />

      <section class="facts" aria-label="What makes it different">
        {facts.map(([title, text], index) => (
          <article>
            <h2 class="sr-only">{title}</h2>
            <p class="sr-only">{text}</p>
            <pre class="ascii" aria-hidden="true" style={`--cols:${columns(fact(title, text))}`} set:html={serverHtml(fact(title, text))} />
          </article>
        ))}
      </section>

      <hr />

      <section class="panel" id="measured" aria-labelledby="measured-heading">
        <h2 id="measured-heading"><span>measured</span></h2>
        <p>Like for like: each renderer against the same renderer in xterm.js. CPU energy as ghostty-webgpu ÷ xterm.js, so below 1.00 uses less. Ties and losses stay on the chart.</p>
        <div class="choices" role="tablist" aria-label="Renderer" id="bench-tabs">
          {measured.map(({ tab }, index) => (
            <button type="button" role="tab" id={`bench-tab-${tab.id}`} aria-controls={`bench-panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
              {tab.label}
            </button>
          ))}
        </div>
        {measured.map(({ tab, data }, index) => (
          <div class="bench" role="tabpanel" id={`bench-panel-${tab.id}`} aria-labelledby={`bench-tab-${tab.id}`} hidden={index !== 0}>
            <div>
              <p class="status">{tab.title} · {tab.status}</p>
              <p class="muted">{tab.method}</p>
            </div>
            {data ? (
              <Fragment>
                <pre class="ascii" data-chart={index} aria-hidden="true" style={`--cols:${columns(chart(data, measured[index]!.max))}`} set:html={serverHtml(chart(data, measured[index]!.max))} />
                <div class="sr-only"><table>
                  <caption>{tab.title}: CPU energy, ghostty-webgpu ÷ xterm.js</caption>
                  <tbody>{Object.entries(data).map(([name, value]) => <tr><th scope="row">{name}</th><td>{value.toFixed(2)}</td></tr>)}</tbody>
                </table></div>
              </Fragment>
            ) : (
              <p class="pending">No chart for this release.</p>
            )}
          </div>
        ))}
        <p class="links"><a href={benchLinks.results}>[ full results ]</a> <a href={benchLinks.recompute}>[ recompute without a browser ]</a></p>
      </section>

      <hr />

      <section class="panel" aria-labelledby="correct-heading">
        <h2 id="correct-heading"><span>correct because it is ghostty</span></h2>
        <div class="split">
          <div>
            <p>Parsing, modes, wrapping, reflow, selection text and Unicode widths come from Ghostty's own core, libghostty-vt <a href={core.revisionUrl}>{core.revision}</a>, unpatched and built with Zig {core.zig}. The renderer and input path are ours, tested in real browsers.</p>
            <p class="muted">{total} cases: {correctness.upstreamCases} from esctest2, {correctness.localCases} Unicode and delivery cases. <a href={correctness.doc}>Every case and failure</a>.</p>
            <p class="muted">Not there yet: images (Sixel, Kitty graphics), ligatures, search, synchronized output.</p>
          </div>
          <ul class="scores">
            {scores.map(({ label, text }, index) => (
              <li>
                <span class="sr-only">{label}: {text}</span>
                <pre class="ascii" data-score={index} aria-hidden="true" style={`--cols:${columns(score(label, scores[index]!.value, scores[index]!.ours))}`} set:html={serverHtml(score(label, scores[index]!.value, scores[index]!.ours))} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <hr />

      <section class="panel" aria-labelledby="xterm-heading">
        <h2 id="xterm-heading"><span>coming from xterm.js</span></h2>
        <p>Creation is async, and data stays as bytes from the PTY to the screen. <a href={docsHref('start/xterm')}>Read the migration guide</a>.</p>
        <dl class="map">
          {migrationComparison.map(({ from, to }) => (
            <div><dt><code>{from}</code></dt><dd><code>{to}</code></dd></div>
          ))}
        </dl>
      </section>

      <hr />

      <section class="panel docs-panel" aria-labelledby="docs-heading">
        <h2 id="docs-heading"><span>docs</span></h2>
        <div class="tree">
          {docsIndex.map((column) => (
            <div>
              <a class="branch" href={column.links[0]!.href}>{column.title}/</a>
              <ul>{column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <hr />

      <section class="panel" aria-labelledby="roadmap-heading">
        <h2 id="roadmap-heading"><span>roadmap</span></h2>
        <ul class="roadmap">
          {roadmap.map((item) => (
            <li>
              {item.state === 'done' ? (
                <span class="done">[done]</span>
              ) : (
                <span class="wip"><span class="ascii inline" data-working aria-hidden="true" set:html={serverHtml(working)} /><span class="sr-only">In progress</span></span>
              )}
              <a href={item.plan}>{item.text}</a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p><a href="https://shaullavo.github.io/ghostty-webgpu/">Classic edition</a></p>
      <p>MIT licensed. Built on libghostty-vt. Not affiliated with the Ghostty project. Scenes and art from <a href="https://ascii.rest">ascii.rest</a> (<a href="licenses/ascii.rest.txt">MIT licence</a>), set in Paper Mono (<a href="licenses/paper-mono.txt">OFL</a>).</p>
      <p><a href="https://github.com/ShaulLavo/fregat">Fregat</a> · <a href="https://github.com/ShaulLavo/singapore">Singapore editor</a> · <a href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md">Changelog</a></p>
    </footer>

    <script type="application/json" id="page-data" set:html={JSON.stringify(pageData)} />
    <script src="../landing.ts"></script>
  </body>
</html>
