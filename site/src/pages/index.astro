---
import landingCss from '../styles/landing.css?inline'
import SceneTheme from '../components/SceneTheme.astro'
import gridSource from '../scene/grid.js?raw'
import firstFrameSource from '../scene/first-frame.js?raw'
import { box, chart, columns, fact, score, serverHtml, still, wordmark, working } from '../scene/art'
import { benchLinks, benchTabs } from '../measurements'
import { core, correctness } from '../correctness'
import { docsHref, docsIndex, roadmap } from '../site-links'
import { migrationComparison } from '../examples/migration-comparison'

const version = __SITE_VERSION__

const facts = [
  [
    'Per-cell damage',
    'A Zig frame builder tracks dirty rows and uploads only changed byte ranges. An idle screen submits zero GPU work.',
  ],
  [
    'Four renderers',
    'First paint lands on Canvas 2D while WebGPU or WebGL2 warms up, then swaps in place. Falls back to Canvas or DOM.',
  ],
  [
    'Worker execution',
    'Import ghostty-webgpu/worker to run libghostty-vt, frame building, and GPU rendering on OffscreenCanvas.',
  ],
] as const

const measured = benchTabs.map((tab) => {
  if (tab.kind === 'pending') return { tab, data: undefined, max: 0 }
  const data = Object.fromEntries(tab.rows.map((row) => [row.workload, row.energy]))
  return { tab, data, max: Math.max(1.4, ...tab.rows.map((row) => row.energy)) }
})

const total = correctness.upstreamCases + correctness.localCases
const scores = correctness.scores.map((entry) => ({
  label: `${entry.terminal} ${entry.version}`.trim(),
  value: entry.pass / total,
  ours: entry.terminal === 'ghostty-webgpu',
  text: `${entry.pass} of ${total}`,
}))

// The banner as its canvas colours it: letters (its ▓ fill) fade from the accent to the second colour across the
// columns, and the shadow strokes are muted.
function wordmarkLayers(text: string) {
  return {
    letters: text.replace(/[^▓\n]/g, ' '),
    shadow: text.replace(/▓/g, ' '),
  }
}

// Each ascii.rest piece on the page: the server writes its first frame as text, and the page redraws it in the
// scene's colours.
const arts = {
  wordmark: wordmarkLayers(still(wordmark)),
}
const pageData = {
  charts: measured.map(({ data, max }) => (data ? { data, max } : null)),
  scores: scores.map(({ label, value, ours }) => ({ label, value, ours })),
}

// The grid module and the first-frame painter, inlined and scoped so the hero paints before any bundle loads.
const firstFrameScript = ['(() => {', gridSource.replace(/^export /gm, ''), firstFrameSource, '})()'].join('\n')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ghostty-webgpu: Ghostty's terminal core in the browser</title>
    <meta
      name="description"
      content="Unpatched libghostty-vt compiled to WebAssembly, with WebGPU, WebGL2, Canvas 2D, and DOM renderers that upload only changed cells."
    />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="ghostty-vt.wasm" as="fetch" type="application/wasm" crossorigin />
    <link rel="preload" href="bridge.wasm" as="fetch" type="application/wasm" crossorigin />
    <SceneTheme fresh />
    <style is:inline set:html={landingCss}></style>
  </head>
  <body>
    <header class="hero">
      <div class="scene" id="scene" aria-hidden="true" inert>
        <canvas class="scene-first" id="scene-first"></canvas>
      </div>
      <script type="text/plain" id="scene-frame"></script>
      <script is:inline set:html={firstFrameScript}></script>
      <div class="hero-copy">
        <h1>
          <span class="sr-only">ghostty-webgpu</span>
          <span class="art wordmark" data-art="wordmark" aria-hidden="true" style={box(wordmark)}
            ><pre><span class="letters">{arts.wordmark.letters}</span><span class="shadow">{arts.wordmark.shadow}</span></pre></span
          >
        </h1>
        <p class="lede">
          Ghostty's unpatched libghostty-vt core compiled to WebAssembly. WebGPU, WebGL2, Canvas 2D, and DOM renderers with per-cell damage tracking.
        </p>
      </div>
    </header>

    <nav class="bar" aria-label="Project">
      <a href={docsHref()}>[ docs ]</a>
      <a href="#measured">[ benchmarks ]</a>
      <a href="https://github.com/ShaulLavo/ghostty-webgpu">[ github ]</a>
      <a href="https://www.npmjs.com/package/ghostty-webgpu">[ npm ]</a>
      <a class="version" href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md">v{version}</a>
      <span class="credit" id="credit">scene from <a href="https://ascii.rest">ascii.rest</a></span>
    </nav>

    <main>
      <section class="install" aria-label="Install">
        <span class="prompt" aria-hidden="true">&gt;</span>
        <code id="install-command">npm install ghostty-webgpu</code>
        <button type="button" id="copy-install">[ copy ]</button>
      </section>

      <hr />

      <section class="facts" aria-label="Architecture">
        {facts.map(([title, text]) => (
          <article>
            <h2 class="sr-only">{title}</h2>
            <p class="sr-only">{text}</p>
            <pre
              class="ascii"
              aria-hidden="true"
              style={`--cols:${columns(fact(title, text))}`}
              set:html={serverHtml(fact(title, text))}
            />
          </article>
        ))}
      </section>

      <hr />

      <section class="panel" id="measured" aria-labelledby="measured-heading">
        <h2 id="measured-heading"><span>measured</span></h2>
        <p>
          In the November 2026 five-way suite (17 workloads at 1 and 16 terminals against xterm.js 6.0.0, ghostty-web 0.4.0, Wraith 0.6.1, and Restty 0.3.0), ghostty-webgpu uses a median <strong>0.71x</strong> whole-browser CPU on Linux and <strong>0.77x</strong> on M1 Mac relative to the best competitor in each cell. Main-entry cold download is 269.2 KiB brotli.
        </p>
        <dl class="summary-strip" aria-label="November 2026 five-way benchmark summary">
          <div>
            <dt>Linux PC CPU (34 cells)</dt>
            <dd><strong>26 wins</strong>, 5 even, 3 losses (median 0.71x)</dd>
          </div>
          <div>
            <dt>M1 Mac CPU (34 cells)</dt>
            <dd><strong>24 wins</strong>, 9 even, 1 loss (median 0.77x)</dd>
          </div>
          <div>
            <dt>Download (main, auto)</dt>
            <dd><strong>269.2 KiB</strong> brotli, 80 ms PC / 101 ms Mac cold paint</dd>
          </div>
        </dl>
        <p class="muted">
          The interactive charts below show the paired Mac M1 CPU-energy ratios (ghostty-webgpu ÷ xterm.js, same renderer class, below 1.00 uses less energy). Ties and losses stay on the chart.
        </p>
        <div class="choices" role="tablist" aria-label="Renderer" id="bench-tabs">
          {measured.map(({ tab }, index) => (
            <button
              type="button"
              role="tab"
              id={`bench-tab-${tab.id}`}
              aria-controls={`bench-panel-${tab.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
        {measured.map(({ tab, data }, index) => (
          <div
            class="bench"
            role="tabpanel"
            id={`bench-panel-${tab.id}`}
            aria-labelledby={`bench-tab-${tab.id}`}
            hidden={index !== 0}
          >
            <div>
              <p class="status">
                {tab.title} · {tab.status}
              </p>
              <p class="muted">{tab.method}</p>
            </div>
            {data ? (
              <Fragment>
                <pre
                  class="ascii"
                  data-chart={index}
                  aria-hidden="true"
                  style={`--cols:${columns(chart(data, measured[index]!.max))}`}
                  set:html={serverHtml(chart(data, measured[index]!.max))}
                />
                <div class="sr-only">
                  <table>
                    <caption>{tab.title}: CPU energy, ghostty-webgpu ÷ xterm.js</caption>
                    <tbody>
                      {Object.entries(data).map(([name, value]) => (
                        <tr>
                          <th scope="row">{name}</th>
                          <td>{value.toFixed(2)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </Fragment>
            ) : (
              <p class="pending">No chart for this release.</p>
            )}
          </div>
        ))}
        <p class="links">
          <a href={benchLinks.results}>[ full benchmark report ]</a>
          <a href={benchLinks.recompute}>[ recompute without a browser ]</a>
        </p>
      </section>

      <hr />

      <section class="panel" aria-labelledby="correct-heading">
        <h2 id="correct-heading"><span>correct because it is ghostty</span></h2>
        <div class="split">
          <div>
            <p>
              Escape parsing, modes, wrapping, reflow, selection text, and Unicode widths come straight from upstream libghostty-vt <a href={core.revisionUrl}>{core.revision}</a>, built unpatched with Zig {core.zig}. The browser host, Zig frame builder, and four renderers sit on top of that single native state.
            </p>
            <p class="muted">
              {total} cases in headless Chromium: {correctness.upstreamCases} esctest2 methods plus {correctness.localCases} Unicode, grapheme, and byte-delivery cases. Both ghostty-webgpu failures match native Ghostty 1.3.1. <a href={correctness.doc}>Every case and failure</a>.
            </p>
            <p class="muted">
              Shipped: DEC mode 2026 synchronized output, mode 2027 grapheme clustering, opt-in GSUB ligatures, lazy BiDi, OSC 8 links. Not built yet: Sixel/Kitty graphics and retained-buffer search.
            </p>
          </div>
          <ul class="scores">
            {scores.map(({ label, text }, index) => (
              <li>
                <span class="sr-only">
                  {label}: {text}
                </span>
                <pre
                  class="ascii"
                  data-score={index}
                  aria-hidden="true"
                  style={`--cols:${columns(score(label, scores[index]!.value, scores[index]!.ours))}`}
                  set:html={serverHtml(score(label, scores[index]!.value, scores[index]!.ours))}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <hr />

      <section class="panel" aria-labelledby="xterm-heading">
        <h2 id="xterm-heading"><span>coming from xterm.js</span></h2>
        <p>
          Creation and opening are async, fitting runs automatically during <code>open()</code>, and PTY traffic stays as <code>Uint8Array</code> bytes end to end. <a href={docsHref('start/xterm')}>Read the migration guide</a>.
        </p>
        <dl class="map">
          {migrationComparison.map(({ from, to }) => (
            <div>
              <dt>
                <code>{from}</code>
              </dt>
              <dd>
                <code>{to}</code>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <hr />

      <section class="panel docs-panel" aria-labelledby="docs-heading">
        <h2 id="docs-heading"><span>docs</span></h2>
        <div class="tree">
          {docsIndex.map((column) => (
            <div>
              <a class="branch" href={column.links[0]!.href}>
                {column.title}/
              </a>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <hr />

      <section class="panel" aria-labelledby="roadmap-heading">
        <h2 id="roadmap-heading"><span>roadmap</span></h2>
        <ul class="roadmap">
          {roadmap.map((item) => (
            <li>
              {item.state === 'done' ? (
                <span class="done">[done]</span>
              ) : (
                <span class="wip">
                  <span class="ascii inline" data-working aria-hidden="true" set:html={serverHtml(working)} />
                  <span class="sr-only">In progress</span>
                </span>
              )}
              <a href={item.plan}>{item.text}</a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p>
        <a href="https://shaullavo.github.io/ghostty-webgpu/">Classic edition</a>
      </p>
      <p>
        MIT licensed. Built on unpatched libghostty-vt. Not affiliated with the Ghostty project. Scenes and ASCII art from <a href="https://ascii.rest">ascii.rest</a> (<a href="licenses/ascii.rest.txt">MIT licence</a>), set in Paper Mono (<a href="licenses/paper-mono.txt">OFL</a>).
      </p>
      <p>
        <a href="https://github.com/ShaulLavo/fregat">Fregat</a> · <a href="https://github.com/ShaulLavo/singapore">Singapore editor</a> · <a href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/CHANGELOG.md">Changelog</a>
      </p>
    </footer>

    <script type="application/json" id="page-data" set:html={JSON.stringify(pageData)} />
    <script src="../landing.ts"></script>
  </body>
</html>
