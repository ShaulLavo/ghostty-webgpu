 } satisfies RendererBenchmark
+
+async function hashPixels(pixels: Uint8Array): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', Uint8Array.from(pixels))
+  return Array.from(new Uint8Array(digest), (value) => value.toString(16).padStart(2, '0')).join('')
+}
+
+function warmAscii(): void {
+  const rasterizer = lastRasterizer
+  if (!rasterizer?.rasterizeBatch) return
+  warmupStartMilliseconds = performance.now() - startupStarted
+  const started = performance.now()
+  const styles = [
+    { weight: 'normal', italic: false },
+    { weight: 'bold', italic: false },
+    { weight: 'normal', italic: true },
+    { weight: 'bold', italic: true },
+  ] as const
+  rasterizer.rasterizeBatch(styles.flatMap((style) =>
+    Array.from({ length: 95 }, (_, index) => ({
+      cellSpan: 1, foreground: { r: 255, g: 255, b: 255 },
+      text: String.fromCharCode(32 + index), ...style,
+    })),
+  ))
+  warmupMilliseconds = performance.now() - started
+}
