+const stages = { rasterMilliseconds: 0, rasterCalls: 0, parsedWrites: 0, observerFrames: 0 }
+let rasterDepth = 0
+let lastRasterizer: CanvasGlyphRasterizer | undefined
+let warmupStartMilliseconds = 0
+let warmupMilliseconds = 0
+const prototype = CanvasGlyphRasterizer.prototype
+for (const name of ['rasterize', 'rasterizeBatch'] as const) {
+  const original = prototype[name]
+  if (!original) continue
+  Object.defineProperty(prototype, name, {
+    value: function (this: CanvasGlyphRasterizer, ...args: unknown[]) {
+      lastRasterizer = this
+      const outer = rasterDepth === 0
+      const started = performance.now()
+      rasterDepth += 1
+      try {
+        return Reflect.apply(original, this, args)
+      } finally {
+        rasterDepth -= 1
+        if (outer) {
+          stages.rasterMilliseconds += performance.now() - started
+          stages.rasterCalls += 1
+        }
+      }
+    },
+  })
+}
+const atlasPages = new Map<string, Uint8Array>()
+const consumeUploads = GlyphAtlas.prototype.consumeUploads
+GlyphAtlas.prototype.consumeUploads = function () {
+  const uploads = consumeUploads.call(this)
+  for (const upload of uploads) atlasPages.set(upload.kind + '/' + upload.layer, upload.pixels.slice())
+  return uploads
+}
+let resetAtlas: (() => void) | undefined
+let firstContentMilliseconds = 0
+const startupStarted = performance.now()
