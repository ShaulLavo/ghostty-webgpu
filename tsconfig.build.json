{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    // The package build sees the whole program, so tsc inlines const enums instead of shipping
    // them as runtime objects. Type checking keeps the isolated rules from tsconfig.json.
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/tests/**"]
}
