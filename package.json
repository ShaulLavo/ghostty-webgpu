{
  "name": "ghostty-webgpu",
  "version": "0.1.0",
  "description": "libghostty-vt for the web with DOM input and damage-scheduled WebGPU rendering",
  "homepage": "https://github.com/ShaulLavo/ghostty-webgpu#readme",
  "bugs": {
    "url": "https://github.com/ShaulLavo/ghostty-webgpu/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/ghostty-webgpu.git"
  },
  "files": [
    "dist",
    "ghostty-vt.wasm",
    "bridge.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm",
    "./bridge.wasm": "./bridge.wasm"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bridge": "bun scripts/build-bridge.ts",
    "build:wasm": "bun scripts/build-wasm.ts",
    "bench:renderer": "bun scripts/renderer-benchmark.ts",
    "demo": "bun run --cwd demo start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "bun run build",
    "test": "bun run test:unit && bun run test:browser",
    "test:browser": "bun scripts/browser-tests.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitest/browser-playwright": "4.1.10",
    "@webgpu/types": "0.1.72",
    "oxfmt": "0.64.0",
    "oxlint": "1.70.0",
    "playwright": "1.60.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10"
}
