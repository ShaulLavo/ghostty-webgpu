{
  "name": "ghostty-webgpu",
  "version": "0.3.29",
  "description": "Ghostty terminal emulation for the browser with WebGPU, WebGL, canvas, and DOM renderers.",
  "keywords": [
    "browser",
    "ghostty",
    "terminal",
    "terminal-emulator",
    "wasm",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://ghostty.shaulavo.dev/",
  "bugs": {
    "url": "https://github.com/ShaulLavo/ghostty-webgpu/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/ghostty-webgpu.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "demo",
      "site",
      "site-classic"
    ]
  },
  "files": [
    "dist",
    "types",
    "native/config-resolver/manifest.json",
    "native/config-resolver/darwin-arm64",
    "native/config-resolver/darwin-x64",
    "native/config-resolver/linux-arm64",
    "native/config-resolver/linux-x64",
    "ghostty-vt.wasm",
    "ghostty-vt.provenance.json",
    "bridge.wasm",
    "canvas-compose.wasm",
    "canvas-compose-scalar.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/legacy/index.d.ts",
  "typesVersions": {
    ">=7.0": {
      "config-resolver": [
        "dist/config-resolver/index.d.ts"
      ],
      "core": [
        "dist/core/index.d.ts"
      ],
      "types/legacy/index.d.ts": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ],
      "hotkeys": [
        "dist/extensions/hotkeys/index.d.ts"
      ]
    },
    "*": {
      "config-resolver": [
        "types/legacy/config-resolver.d.ts"
      ],
      "core": [
        "types/legacy/core.d.ts"
      ],
      "types/legacy/index.d.ts": [
        "types/legacy/index.d.ts"
      ],
      "worker": [
        "types/legacy/worker.d.ts"
      ],
      "hotkeys": [
        "types/legacy/hotkeys.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types@>=7.0": "./dist/index.d.ts",
      "types": "./types/legacy/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config-resolver": {
      "types@>=7.0": "./dist/config-resolver/index.d.ts",
      "types": "./types/legacy/config-resolver.d.ts",
      "bun": "./dist/config-resolver/index.js",
      "node": "./dist/config-resolver/index.js"
    },
    "./core": {
      "types@>=7.0": "./dist/core/index.d.ts",
      "types": "./types/legacy/core.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm",
    "./bridge.wasm": "./bridge.wasm",
    "./canvas-compose.wasm": "./canvas-compose.wasm",
    "./canvas-compose-scalar.wasm": "./canvas-compose-scalar.wasm",
    "./worker": {
      "types@>=7.0": "./dist/worker/index.d.ts",
      "types": "./types/legacy/worker.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./hotkeys": {
      "types@>=7.0": "./dist/extensions/hotkeys/index.d.ts",
      "types": "./types/legacy/hotkeys.d.ts",
      "import": "./dist/extensions/hotkeys/index.js",
      "default": "./dist/extensions/hotkeys/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:canvas-compose": "bun scripts/build-canvas-compose.ts && bun scripts/build-canvas-compose.ts --scalar --output canvas-compose-scalar.wasm",
    "build": "bun run clean && tsc -p tsconfig.build.json && bun run build:bidi && bun run build:worker",
    "build:bidi": "bun scripts/build-bidi.ts",
    "build:worker": "bun run scripts/build-worker.ts",
    "build:bridge": "bun scripts/build-bridge.ts",
    "build:config-resolver": "bun scripts/build-config-resolver.ts",
    "config-resolver:bootstrap": "bun scripts/config-resolver-native/generate-native-inputs.ts --write && bun scripts/config-resolver-native/generate-bootstrap.ts --write",
    "build:source-only": "bun run verify:config-resolver-state --state bootstrap && bun run build",
    "build:wasm": "bun scripts/build-wasm.ts",
    "bench:compare": "bun scripts/comparison.ts",
    "bench:compare:test": "bun test ./bench/comparison-*.test.mjs ./scripts/comparison-*.test.mjs",
    "bench:renderer": "bun scripts/renderer-benchmark.ts",
    "clean": "bun scripts/clean-dist.ts",
    "demo": "bun run --cwd demo start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --disable-nested-config .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify",
    "test": "bun run test:unit && bun run test:browser",
    "test:bridge": "zig test scripts/row-index.test.zig",
    "test:browser": "bun scripts/browser-tests.ts",
    "test:package": "bun scripts/package-smoke.ts --browser",
    "test:renderer-fallbacks": "bun scripts/browser-tests.ts src/render/webgl/ src/render/tests/selector.browser.test.ts src/render/tests/fallback.browser.test.ts src/render/canvas/renderer.browser.test.ts src/render/dom/renderer.browser.test.ts src/dom/tests/renderer-fallback.browser.test.ts",
    "test:renderer-smoke": "bun scripts/renderer-fallback-smoke.ts",
    "test:unit": "vitest run && bun run bench:compare:test && node --test scripts/autoresearch-checkpoint.test.mjs && bun test ./.internal/worker-delta-prototype/codec.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run verify:extensions && bun run test && bun run test:renderer-smoke && bun run --cwd site docs:check && bun run pack:release && bun run test:package:built",
    "verify:config-resolver-artifacts": "bun scripts/verify-config-resolver-artifacts.ts --state assembled",
    "verify:config-resolver-state": "bun scripts/verify-config-resolver-artifacts.ts",
    "verify:source-only": "bun run build:source-only && bun run typecheck && bun run lint && bun run format:check && bun run verify:extensions && bun run test && bun run test:renderer-smoke",
    "build:host": "bun run verify:config-resolver-artifacts && bun run build",
    "test:package:host": "bun scripts/package-smoke.ts",
    "verify:host": "bun run verify:config-resolver-artifacts && bun run verify && bun run test:package:host",
    "site:build": "bun run --cwd site build",
    "site:dev": "bun run --cwd site dev",
    "site:classic:build": "bun run --cwd site-classic build",
    "site:classic:dev": "bun run --cwd site-classic dev",
    "test:site-classic": "vitest run site-classic/src",
    "pack:release": "bun scripts/release.ts pack",
    "test:package:built": "bun scripts/release.ts check",
    "verify:extensions": "bun run --cwd packages/line-editor build && bun run --cwd packages/line-editor typecheck && bun run --cwd packages/line-editor test && bun run --cwd packages/line-editor test:package && bun run --cwd packages/shaders build && bun run --cwd packages/shaders typecheck && bun run --cwd packages/shaders test && bun run --cwd packages/shaders test:package",
    "site:worker:build": "bun run build && bun run --cwd site build --base /",
    "site:worker:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .artifacts/site-worker",
    "site:worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "sites:verify": "bash scripts/verify-sites.sh"
  },
  "dependencies": {
    "@webgpu/types": "0.1.74"
  },
  "devDependencies": {
    "@discoveryjs/json-ext": "1.1.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fregat/hotkeys": "https://github.com/ShaulLavo/hotkeys/releases/download/hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd/fregat-hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd.tgz",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@vitest/browser-playwright": "5.0.2",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "bidi-js": "1.0.3",
    "ghostty-web": "0.4.0",
    "oxc-parser": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.149.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@fregat/hotkeys": "^0.0.3"
  },
  "peerDependenciesMeta": {
    "@fregat/hotkeys": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "vitest@5.0.2": "patches/vitest@5.0.2.patch",
    "@vitest/mocker@5.0.2": "patches/@vitest%2Fmocker@5.0.2.patch",
    "@vitest/browser-playwright@5.0.2": "patches/@vitest%2Fbrowser-playwright@5.0.2.patch"
  }
}
