{
  "name": "ghostty-webgpu",
  "version": "0.3.19",
  "description": "Ghostty for the web with a damage-aware WebGPU renderer and native API",
  "keywords": [
    "browser",
    "ghostty",
    "terminal",
    "terminal-emulator",
    "wasm",
    "webgpu"
  ],
  "homepage": "https://github.com/ShaulLavo/ghostty-webgpu#readme",
  "bugs": {
    "url": "https://github.com/ShaulLavo/ghostty-webgpu/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/ghostty-webgpu.git"
  },
  "workspaces": {
    "packages": [],
    "catalog": {
      "@fregat/hotkeys": "https://github.com/ShaulLavo/fregat/releases/download/hotkeys-0.0.2-68d8aaf6f631-260650623e7e/fregat-hotkeys-0.0.2-68d8aaf6f631-260650623e7e.tgz"
    }
  },
  "files": [
    "dist",
    "types",
    "native/config-resolver/manifest.json",
    "native/config-resolver/darwin-arm64",
    "native/config-resolver/darwin-x64",
    "native/config-resolver/linux-arm64",
    "native/config-resolver/linux-x64",
    "ghostty-vt.wasm",
    "ghostty-vt.provenance.json",
    "bridge.wasm",
    "canvas-compose.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/legacy/index.d.ts",
  "typesVersions": {
    ">=7.0": {
      "config-resolver": [
        "dist/config-resolver/index.d.ts"
      ],
      "types/legacy/index.d.ts": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    },
    "*": {
      "config-resolver": [
        "types/legacy/config-resolver.d.ts"
      ],
      "types/legacy/index.d.ts": [
        "types/legacy/index.d.ts"
      ],
      "worker": [
        "types/legacy/worker.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types@>=7.0": "./dist/index.d.ts",
      "types": "./types/legacy/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config-resolver": {
      "types@>=7.0": "./dist/config-resolver/index.d.ts",
      "types": "./types/legacy/config-resolver.d.ts",
      "bun": "./dist/config-resolver/index.js",
      "node": "./dist/config-resolver/index.js"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm",
    "./bridge.wasm": "./bridge.wasm",
    "./canvas-compose.wasm": "./canvas-compose.wasm",
    "./worker": {
      "types@>=7.0": "./dist/worker/index.d.ts",
      "types": "./types/legacy/worker.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:canvas-compose": "bun scripts/build-canvas-compose.ts",
    "build": "bun run clean && tsc -p tsconfig.build.json && bun run build:worker",
    "build:worker": "bun run scripts/build-worker.ts",
    "build:bridge": "bun scripts/build-bridge.ts",
    "build:config-resolver": "bun scripts/build-config-resolver.ts",
    "config-resolver:bootstrap": "bun scripts/config-resolver-native/generate-native-inputs.ts --write && bun scripts/config-resolver-native/generate-bootstrap.ts --write",
    "build:source-only": "bun run verify:config-resolver-state --state bootstrap && bun run clean && tsc -p tsconfig.build.json && bun run build:worker",
    "build:wasm": "bun scripts/build-wasm.ts",
    "bench:compare": "bun scripts/comparison.ts",
    "bench:compare:test": "bun test ./bench/comparison-*.test.mjs ./scripts/comparison-*.test.mjs",
    "bench:renderer": "bun scripts/renderer-benchmark.ts",
    "clean": "bun scripts/clean-dist.ts",
    "demo": "bun run --cwd demo start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --disable-nested-config .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify",
    "test": "bun run test:unit && bun run test:browser",
    "test:browser": "bun scripts/browser-tests.ts",
    "test:package": "bun scripts/package-smoke.ts --browser",
    "test:renderer-fallbacks": "bun scripts/browser-tests.ts src/render/webgl/ src/render/tests/selector.browser.test.ts src/render/tests/fallback.browser.test.ts src/render/canvas/renderer.browser.test.ts src/render/dom/renderer.browser.test.ts src/dom/tests/renderer-fallback.browser.test.ts",
    "test:renderer-smoke": "bun scripts/renderer-fallback-smoke.ts",
    "test:unit": "vitest run && bun run bench:compare:test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:renderer-smoke && bun run test:package",
    "verify:config-resolver-artifacts": "bun scripts/verify-config-resolver-artifacts.ts --state assembled",
    "verify:config-resolver-state": "bun scripts/verify-config-resolver-artifacts.ts",
    "verify:source-only": "bun run build:source-only && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:renderer-smoke",
    "build:host": "bun run verify:config-resolver-artifacts && bun run build",
    "test:package:host": "bun scripts/package-smoke.ts",
    "verify:host": "bun run verify:config-resolver-artifacts && bun run verify && bun run test:package:host",
    "site:build": "bun run --cwd site build",
    "site:dev": "bun run --cwd site dev"
  },
  "dependencies": {
    "@fregat/hotkeys": "catalog:",
    "@webgpu/types": "0.1.74"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@vitest/browser-playwright": "5.0.2",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ghostty-web": "0.4.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "vitest@5.0.2": "patches/vitest@5.0.2.patch"
  }
}
