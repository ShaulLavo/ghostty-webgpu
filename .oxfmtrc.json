{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules", "dist", "coverage", "bun.lock", "*.tsbuildinfo"]
}
